service : {
  configure : (principal, principal) -> (variant { Ok : null; Err : text });
  add_liquidity : (nat, nat) -> (variant { Ok : nat; Err : text });
  remove_liquidity : (nat) -> (variant { Ok : record { nat; nat }; Err : text });
  swap : (principal, nat, nat) -> (variant { Ok : nat; Err : text });
  get_reserves : () -> (record { nat; nat }) query;
  get_snapshot : () -> (record {
    token_a : principal;
    token_b : principal;
    reserve_a : nat;
    reserve_b : nat;
    total_supply : nat;
    configured : bool;
  }) query;
  get_balance : (principal) -> (nat) query;
  total_supply : () -> (nat) query;
}
